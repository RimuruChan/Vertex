# Vertex 部署环境变量(复制为 .env 并填写所有必填项)
# 可使用 `openssl rand -hex 32` 分别生成下面的密码与 token。
POSTGRES_PASSWORD=
APP_ENV=development
JWT_SECRET=
JUDGE_API_TOKEN=
JUDGE_LONG_POLL_TIMEOUT=25s
JUDGE_LEASE_TTL=45s
JUDGE_HTTP_TIMEOUT=40s
JUDGE_WORKERS=2
# 出题包构建:一次构建要编译多个程序并跑完所有测试点,租约比判题长。
BUILD_LEASE_TTL=120s
BUILD_WORKER_ENABLED=true
BUILD_PROGRESS_INTERVAL=15s
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
# 应用限流只使用 TCP RemoteAddr，不信任客户端传入的 X-Forwarded-For。
# 反向代理或多 server 实例部署，应在可信 ingress 再配置真实客户端/分布式限流。
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_KEYS=10000
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_CLIENT_RATE_LIMIT=120
AUTH_REGISTER_RATE_LIMIT=20
CONTEST_REGISTER_RATE_LIMIT=10
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true
JUDGE_WORKER_ID=
# 留空时使用容器 hostname；docker compose --scale 时必须保持为空。
SANDBOX_INSTANCE_ID=
SANDBOX_BOX_ID=0
SANDBOX_TIME_OVERSHOOT_MS=1000
SANDBOX_WORKSPACE_BYTES=67108864
SANDBOX_WORKSPACE_INODES=4096
SANDBOX_CPUSET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@vertex.local
SERVER_PORT=8080
NGINX_PORT=80
