# Vertex 部署环境变量(复制为 .env 并填写所有必填项)
# 可使用 `openssl rand -hex 32` 分别生成下面的密码与 token。
POSTGRES_PASSWORD=
APP_ENV=development
JWT_SECRET=
JUDGE_API_TOKEN=
JUDGE_LONG_POLL_TIMEOUT=25s
JUDGE_LEASE_TTL=45s
JUDGE_HTTP_TIMEOUT=40s
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true
JUDGE_WORKER_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@vertex.local
SERVER_PORT=8080
NGINX_PORT=80
